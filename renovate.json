{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Limit Python versions to 3.11, 3.12, 3.13, or 3.14 for Apache Beam and Dataflow compatibility",
      "matchPackageNames": [
        "python",
        "docker.io/library/python",
        "actions/python-versions"
      ],
      "allowedVersions": "/^(?:v?3\\.(?:11|12|13|14))(?:[.-]|$)/"
    },
    {
      "description": "Limit Python versions to 3.11, 3.12, 3.13, or 3.14 for Apache Beam and Dataflow compatibility",
      "matchDepNames": [
        "python",
        "docker.io/library/python",
        "actions/python-versions"
      ],
      "allowedVersions": "/^(?:v?3\\.(?:11|12|13|14))(?:[.-]|$)/"
    },
    {
      "description": "Group Apache Beam dependencies across Python SDK and Docker boot containers",
      "matchPackageNames": [
        "apache-beam",
        "apache/beam_python3.13_sdk",
        "apache/beam_python3.14_sdk"
      ],
      "groupName": "apache-beam"
    }
  ]
}
